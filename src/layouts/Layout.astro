---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	/** Page-specific share image, root-relative (e.g. '/images/projects/365-photo.jpg'). */
	image?: string;
	/** Set on pages that should stay out of search results. */
	noindex?: boolean;
	/**
	 * Lifts the header onto the page's first section as white-on-media. Only for
	 * pages that open on a full-bleed dark hero; anywhere else it renders on sand.
	 */
	headerOver?: boolean;
}

const {
	title,
	description = 'Auristate Tourism Investment builds world-class destinations that embody elegance, opportunity, and cultural connection. A Syrian joint-stock company specialized in real estate and tourism investment.',
	image = '/og-image.png',
	noindex = false,
	headerOver = false
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Social platforms reject
// relative image paths, so these must be absolute — if `site` is ever removed,
// new URL() throws at build time rather than shipping silently broken previews.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Auristate" />
		<meta property="og:locale" content="en" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Auristate — Tourism Investments" />

		{/* summary_large_image is what gives the full-width card; without it X
		    falls back to a small square thumbnail. */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Auristate — Tourism Investments" />

		{/* Colors the browser chrome on mobile to match the hero's dark ground. */}
		<meta name="theme-color" content="#1a1a1a" />

		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" />
	</head>
	{/* The column keeps the footer at the bottom on pages shorter than the
	    viewport — `body` carries no background of its own, so without it a short
	    page ends on bare white below the footer. */}
	<body>
		<div class="flex min-h-dvh flex-col bg-sand text-ink">
			{/* Positioned ancestor for the `headerOver` header, which is out of flow
			    and pins to the top of this wrapper — i.e. over whatever section
			    `<main>` opens with. */}
			<div class="relative flex-1">
				<Header over={headerOver} />
				<main>
					<slot />
				</main>
			</div>
			<Footer />
		</div>

		{/* Site-wide, so `.reveal` works on every page without the page opting in. */}
		<script>
			import '../scripts/reveal.js';
		</script>
	</body>
</html>
