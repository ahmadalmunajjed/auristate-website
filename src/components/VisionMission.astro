---
import SectionHeading from './SectionHeading.astro';
import { visionMission } from '../data/site';
---

{/* One framed panel on the warm ground. A gold-gradient card was tried and
    dropped: ink body copy measures 3.95:1 on the gradient's dark end, under
    the 4.5:1 minimum. bg-sand is deliberate — News above is bg-white/50, so
    the bare ground is what separates the two. Keep id="vision-mission": the
    header's About Us dropdown anchors to it. */}
<section id="vision-mission" class="relative isolate overflow-hidden bg-sand py-24">
	<!-- Classic band rule closing off the white section above. -->
	<div
		class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-dark/35 to-transparent"
		aria-hidden="true"
	>
	</div>
	<div class="vm-glow" aria-hidden="true"></div>

	<div class="mx-auto max-w-page px-6">
		<div class="reveal text-center">
			<SectionHeading eyebrow="Our Purpose" title="Vision & Mission" align="center" />

			<!-- Ornamental divider: the two rules draw outward from the diamond
			     once the heading reveals. -->
			<div class="mt-7 flex items-center justify-center gap-4" aria-hidden="true">
				<span class="vm-rule vm-rule--left"></span>
				<svg viewBox="0 0 16 16" class="h-2.5 w-2.5 text-gold-dark">
					<rect
						x="3"
						y="3"
						width="10"
						height="10"
						transform="rotate(45 8 8)"
						fill="currentColor"
						opacity="0.75"></rect>
				</svg>
				<span class="vm-rule vm-rule--right"></span>
			</div>
		</div>

		<article
			class="vm-panel reveal relative mt-14 rounded-3xl border border-gold-dark/20 bg-white/70 p-8 md:mt-16 md:p-12 lg:p-16"
			style="--reveal-delay: 140ms"
		>
			{/* Double rule — the inner hairline is what makes it read as a frame
			    rather than a card. */}
			<span class="vm-frame" aria-hidden="true" />

			{/* Two columns once the panel is wide enough: a single column at this
			    width would either run past a readable measure or leave the box
			    mostly empty around it. */}
			<div class="mx-auto grid max-w-2xl gap-5 lg:max-w-none lg:grid-cols-2 lg:gap-12">
				{
					visionMission.map((paragraph, i) => (
						<p
							class:list={[
								'text-start leading-[1.9] text-ink/85 md:text-lg',
								i === 0 && 'vm-body'
							]}
						>
							{paragraph}
						</p>
					))
				}
			</div>
		</article>
	</div>
</section>

<style>
	/* Ambient warmth behind the panels. Negative z-index inside the section's
	   own stacking context, so it paints over bg-sand but under the content.

	   It starts at 32% — below the heading — and that is a contrast constraint,
	   not a taste one. The eyebrow is 12px gold-deep, which measures 4.51:1 on
	   bare sand: one hundredth over the 4.5 minimum. Any tint at all spends
	   margin the token does not have — the gold lobe at even 0.10 alpha drops it
	   to 4.32, and the original full-bleed version measured 3.67. Dimming cannot
	   recover it, so the glow stays off the heading instead. Panels are white/70
	   over the glow, which lifts the same eyebrow back to 5.05:1 inside them.
	   Keep the top offset ahead of the drift if you retune either. */
	.vm-glow {
		position: absolute;
		inset: 32% -10% -25%;
		z-index: -1;
		background:
			radial-gradient(50% 45% at 18% 22%, rgba(225, 177, 69, 0.3), transparent 70%),
			radial-gradient(46% 42% at 84% 78%, rgba(180, 124, 39, 0.22), transparent 72%);
		/* Origin is the top edge, so scale(1.08) grows the layer downward and
		   leaves the top where the inset put it. The default centre origin would
		   split the growth and walk the top edge up into the heading by half of
		   it; a bottom origin is worse still — measured, it lifted the top 64px
		   and cut the heading's clearance from 132px to 68px. */
		transform-origin: 50% 0%;
		animation: vm-drift 22s ease-in-out infinite alternate;
	}

	@keyframes vm-drift {
		from {
			transform: translate3d(-2%, 0, 0) scale(1);
		}
		to {
			transform: translate3d(2%, 0, 0) scale(1.08);
		}
	}

	/* --- Heading ornament ------------------------------------------------- */

	.vm-rule {
		display: block;
		height: 1px;
		width: clamp(2.5rem, 12vw, 6rem);
		transform: scaleX(0);
		transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) 0.2s;
	}

	.vm-rule--left {
		transform-origin: right center;
		background: linear-gradient(to right, transparent, var(--color-gold-dark));
	}

	.vm-rule--right {
		transform-origin: left center;
		background: linear-gradient(to left, transparent, var(--color-gold-dark));
	}

	.reveal.is-visible .vm-rule {
		transform: scaleX(1);
	}

	/* --- Panel ------------------------------------------------------------ */

	.vm-panel {
		transition:
			opacity 0.7s cubic-bezier(0.2, 0.6, 0.2, 1),
			transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1),
			border-color 0.4s ease,
			box-shadow 0.4s ease;
		transition-delay: var(--reveal-delay, 0ms), var(--reveal-delay, 0ms), 0ms, 0ms;
	}

	.vm-panel:hover {
		border-color: rgba(180, 124, 39, 0.45);
		box-shadow: 0 20px 45px -28px rgba(180, 124, 39, 0.55);
	}

	.vm-frame {
		position: absolute;
		inset: 0.75rem;
		border: 1px solid rgba(180, 124, 39, 0.16);
		border-radius: 1.35rem;
		opacity: 0;
		transform: scale(1.025);
		transition:
			opacity 0.8s ease 0.25s,
			transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1) 0.25s,
			inset 0.4s ease;
		pointer-events: none;
	}

	.vm-panel.is-visible .vm-frame {
		opacity: 1;
		transform: scale(1);
	}

	.vm-panel:hover .vm-frame {
		inset: 0.6rem;
	}

	/* Serif drop cap against the sans body is the classic pairing — and gold-dark
	   measures 3.16:1 on the panel at this size, clearing the 3:1 large-text
	   threshold it would fail as body copy.

	   Logical properties throughout (`inline-start`, `margin-inline`) so the cap
	   moves to the right edge in the Arabic build rather than stranding itself
	   mid-paragraph. Applies to the opening paragraph only — it renders whatever
	   that copy starts with, so a future rewrite opening on a quote or digit
	   would set that instead. */
	.vm-body::first-letter {
		/* Physical value first as the fallback: an engine without `inline-start`
		   drops that line and keeps `left`, which is correct for the LTR build
		   shipping today. Without it the cap would not float at all and would set
		   as a 3em letter inline. */
		float: left;
		float: inline-start;
		margin-block-start: 0.06em;
		margin-inline: 0 0.1em;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 3.1em;
		line-height: 0.82;
		color: var(--color-gold-dark);
	}

	/* The global reduce block only covers .reveal / .animate-* . Everything above
	   waits on .is-visible, which reveal.js adds regardless of motion preference,
	   so without this the ornament would still animate — or stay invisible. */
	@media (prefers-reduced-motion: reduce) {
		.vm-glow,
		.vm-rule,
		.vm-panel,
		.vm-frame {
			animation: none !important;
			transition: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>
