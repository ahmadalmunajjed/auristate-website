---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/site';
---

{/* bg-white/50 is load-bearing: the hero's bottom scrim fades to #f7f1e6, which
    is what white/50 composites to over sand. Changing it reopens that seam. */}
<section id="about" class="bg-white/50 py-24">
	<div class="mx-auto max-w-page px-6">
		<div class="grid gap-x-16 gap-y-10 md:grid-cols-2">
			<div class="reveal">
				<SectionHeading eyebrow={about.eyebrow} title={about.title} />
				<div class="mt-6 mb-7 h-px w-16 bg-gold-dark/50"></div>
				<p class="text-xl leading-relaxed text-ink/80">{about.lead}</p>
			</div>
			<div class="reveal space-y-5 md:pt-2" style="--reveal-delay: 120ms">
				{about.paragraphs.map((p) => <p class="leading-relaxed text-ink/75">{p}</p>)}
			</div>
		</div>
	</div>
</section>
