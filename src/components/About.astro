---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/site';
---

<section id="about" class="bg-white/50 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="reveal">
			<SectionHeading eyebrow={about.eyebrow} title={about.title} class="mb-6" />
			<div class="max-w-3xl space-y-5">
				{about.paragraphs.map((p) => <p class="leading-relaxed text-charcoal/70">{p}</p>)}
			</div>
		</div>
	</div>
</section>
