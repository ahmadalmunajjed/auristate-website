---
import SectionHeading from './SectionHeading.astro';
import { about } from '../data/site';
---

{/* bg-white/50 is load-bearing: the hero's bottom scrim fades to #f7f1e6, which
    is what white/50 composites to over sand. Keep id="about" — the header's
    About Us dropdown and the footer both anchor here. */}
<section id="about" class="bg-white/50 py-20">
	<div class="mx-auto max-w-page px-6">
		<div class="grid gap-x-16 gap-y-8 md:grid-cols-[minmax(0,4fr)_minmax(0,6fr)]">
			<div class="reveal">
				<SectionHeading eyebrow={about.eyebrow} title={about.title} />
				<span class="ab-rule mt-6 block" aria-hidden="true"></span>

				{/* A purpose fragment, so it stands beside the copy — at the foot of the
				    body column it reads as a dangling third paragraph. Ink, not gold:
				    gold-dark is 3.19:1 here, four hundredths over the large-text line. */}
				<p
					class="ab-statement mt-8 max-w-xs text-xl leading-snug text-ink italic"
					style="font-family: var(--font-display); font-weight: 500;"
				>
					{about.statement}
				</p>
			</div>

			{/* `text-start`, not `text-left` — the Arabic build flips this. */}
			<div class="reveal text-start" style="--reveal-delay: 120ms">
				<p class="text-lg leading-relaxed text-ink/85">{about.lead}</p>
				{about.paragraphs.map((p) => <p class="mt-4 leading-relaxed text-ink/75">{p}</p>)}
			</div>
		</div>
	</div>
</section>

<style>
	.ab-rule {
		height: 1px;
		width: 4rem;
		background: linear-gradient(to right, var(--color-gold-dark), transparent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) 0.2s;
	}

	.reveal.is-visible .ab-rule {
		transform: scaleX(1);
	}

	.ab-statement {
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.7s ease 0.4s,
			transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1) 0.4s;
	}

	.reveal.is-visible .ab-statement {
		opacity: 1;
		transform: translateY(0);
	}

	/* The global reduce block only covers .reveal / .animate-* . Both rules above
	   wait on .is-visible, which reveal.js adds regardless of motion preference,
	   so without this they would stay collapsed and invisible. */
	@media (prefers-reduced-motion: reduce) {
		.ab-rule,
		.ab-statement {
			transition: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>
