---
interface Props {
	eyebrow: string;
	title: string;
	align?: 'left' | 'center';
	class?: string;
}

const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center', className]}>
	{/* The eyebrow is what reads as the section's name, so it carries the size
	    here rather than the title beneath it.
	    gold-deep, not gold-dark: 20px is still normal text by WCAG's measure, so
	    this needs 4.5:1 — gold-dark is 2.83:1 on sand, gold-deep is 4.51:1. Keep
	    it under 24px or that threshold changes and VisionMission's glow offset
	    stops being the constraint AGENTS.md says it is. */}
	<p class="mb-4 text-lg tracking-[0.3em] text-gold-deep uppercase md:text-xl">{eyebrow}</p>
	<h2 class="text-3xl text-ink" style="font-family: var(--font-display); font-weight: 600;">
		{title}
	</h2>
</div>
