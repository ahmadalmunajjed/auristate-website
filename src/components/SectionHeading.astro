---
interface Props {
	eyebrow: string;
	title: string;
	align?: 'left' | 'center';
	class?: string;
}

const { eyebrow, title, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center', className]}>
	<p class="mb-4 text-xs tracking-[0.3em] text-gold-dark uppercase">{eyebrow}</p>
	<h2 class="text-3xl text-charcoal" style="font-family: var(--font-display); font-weight: 600;">
		{title}
	</h2>
</div>
