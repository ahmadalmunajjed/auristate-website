---
import type {ProjectSummary} from '../lib/sanity';
import {urlFor, projectTypeLabel} from '../lib/sanity';

interface Props {
	project: ProjectSummary;
	index: number;
	/**
	 * feature — the only project: full width, cinematic crop.
	 * default — an ordinary tile.
	 */
	variant?: 'feature' | 'default';
	/**
	 * Off inside the carousel: a scroll-in reveal never fires for slides parked
	 * outside the track's overflow box, so they would sit at opacity 0 until an
	 * arrow drags them in and then fade up mid-slide. The track reveals instead.
	 */
	reveal?: boolean;
}

const {project, index, variant = 'default', reveal = true} = Astro.props;

// Client renders are all 16:9. A taller default tile throws away most of the
// frame, so 4:5 rather than the reference design's 9:10.
const aspect = variant === 'feature' ? 'aspect-[16/9]' : 'aspect-[4/5]';

// Ask the CDN for the crop we actually display, rather than shipping a full-size
// original and letting object-cover hide the waste. The default tile is portrait
// against 16:9 sources, so Sanity drops roughly half the width — the hotspot set
// in the Studio decides which half.
const [width, height] = variant === 'feature' ? [1600, 900] : [900, 1125];

// The gallery's first photo IS the card; there is no separate cover field.
// Studio validation requires at least one photo, but a document created before
// that rule would crash urlFor(), so the card falls back to its dark ground
// rather than failing the whole build.
const cover = project.cover;
const src = cover
	? urlFor(cover).width(width).height(height).fit('crop').auto('format').quality(80).url()
	: null;
---

<a
	href={`/projects/${project.slug}`}
	class:list={[
		'project-card group relative block overflow-hidden bg-nearblack',
		reveal && 'reveal',
		aspect
	]}
	style={reveal ? `--reveal-delay: ${index * 120}ms` : undefined}
>
	{
		src && (
			<img
				src={src}
				alt={cover?.alt ?? ''}
				loading="lazy"
				decoding="async"
				class="absolute inset-0 h-full w-full object-cover transition duration-700 ease-out group-hover:scale-115 group-focus-visible:scale-115"
			/>
		)
	}

	{/* Scrim tuned by sampling the brightest pixel behind the title: holds white
	    text above 9:1 on the current renders. Lightening it risks failing AA on
	    a brighter image. */}
	<div
		class="absolute inset-0"
		style="background: linear-gradient(180deg, rgba(26,26,26,0.38) 0%, rgba(26,26,26,0) 30%, rgba(26,26,26,0.30) 52%, rgba(26,26,26,0.72) 78%, rgba(26,26,26,0.88) 100%);"
	>
	</div>

	<div class="relative flex h-full flex-col justify-between p-6 md:p-7">
		<span
			class="self-start bg-white px-4 py-2 text-[0.65rem] font-medium tracking-[0.12em] text-ink uppercase"
		>
			{projectTypeLabel(project.projectType)}
		</span>

		<div>
			<h3
				class="text-2xl leading-tight text-white md:text-3xl"
				style="font-family: var(--font-display); font-weight: 600; text-shadow: 0 2px 16px rgba(26,26,26,0.5);"
			>
				{project.name}
			</h3>
			{
				project.summary && (
					<p
						class="mt-3 max-w-md text-sm leading-relaxed text-white/85"
						style="text-shadow: 0 1px 10px rgba(26,26,26,0.6);"
					>
						{project.summary}
					</p>
				)
			}
		</div>
	</div>
</a>

<style>
	.project-card:focus-visible {
		outline: 2px solid var(--color-gold-light);
		outline-offset: 3px;
	}

	.project-card img {
		will-change: transform;
	}

	/* Tailwind v4's scale-* utilities set the standalone `scale` property, not
	   `transform` — so `transform: none` does NOT cancel them. Reset `scale`. */
	@media (prefers-reduced-motion: reduce) {
		.project-card img {
			transition: none;
			will-change: auto;
		}

		.project-card:hover img,
		.project-card:focus-visible img {
			scale: none;
		}
	}
</style>
