---
import { stats } from '../data/site';
---

<section id="stats" class="py-24">
	<div class="mx-auto max-w-page px-6">
		<div class="grid grid-cols-2 gap-6 md:grid-cols-4">
			{
				stats.map((stat, i) => (
					<div class="reveal rounded-2xl bg-white/60 p-6" style={`--reveal-delay: ${i * 100}ms`}>
						<p class="text-3xl text-gold-dark" style="font-family: var(--font-display); font-weight: 600;">
							{stat.value}
						</p>
						<p class="mt-1 text-sm text-charcoal/60">{stat.label}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
