---
import type {PostSummary} from '../lib/sanity';
import {urlFor} from '../lib/sanity';

interface Props {
	post: PostSummary;
	index: number;
}

const {post, index} = Astro.props;

const dateLabel = post.date
	? new Date(post.date).toLocaleDateString('en-GB', {month: 'short', year: 'numeric'})
	: null;

const image = post.cover
	? urlFor(post.cover).width(800).height(600).fit('crop').auto('format').quality(80).url()
	: null;
---

<a
	href={`/blog/${post.slug}`}
	class="reveal group block"
	style={`--reveal-delay: ${index * 120}ms`}
>
	<div class="aspect-[4/3] overflow-hidden rounded-3xl bg-sand">
		{
			image && (
				<img
					src={image}
					alt={post.cover?.alt ?? ''}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover transition duration-700 ease-out group-hover:scale-105"
				/>
			)
		}
	</div>

	{dateLabel && <p class="mt-6 text-xs tracking-[0.2em] text-gold-deep uppercase">{dateLabel}</p>}

	<h3
		class="mt-3 text-xl leading-snug text-ink transition group-hover:text-gold-deep"
		style="font-family: var(--font-display); font-weight: 600;"
	>
		{post.title}
	</h3>

	<p class="mt-3 leading-relaxed text-ink/75">{post.excerpt}</p>

	<span class="mt-5 inline-block text-sm text-ink/75 transition group-hover:text-gold-deep">
		Read More →
	</span>
</a>
