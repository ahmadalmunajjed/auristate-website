---
import SectionHeading from './SectionHeading.astro';
import { posts } from '../data/site';
---

<section id="news" class="bg-white/50 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<SectionHeading eyebrow="News" title="Insights &amp; Updates" class="mb-14" />
		<div class="grid gap-8 md:grid-cols-3">
			{
				posts.map((post, i) => (
					<a
						href={post.href}
						class="reveal group block rounded-2xl bg-sand p-6"
						style={`--reveal-delay: ${i * 120}ms`}
					>
						<p class="mb-3 text-xs text-charcoal/50">{post.date}</p>
						<h3
							class="text-lg leading-snug text-charcoal group-hover:text-gold-dark"
							style="font-family: var(--font-display); font-weight: 600;"
						>
							{post.title}
						</h3>
					</a>
				))
			}
		</div>
	</div>
</section>
