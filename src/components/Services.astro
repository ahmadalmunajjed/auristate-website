---
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/site';
---

<section id="services" class="bg-white/50 py-24">
	<div class="mx-auto max-w-6xl px-6">
		<div class="reveal">
			<SectionHeading
				eyebrow="Our Services"
				title="From First Study to Final Handover"
				class="mb-14"
				splitTitle
			/>
		</div>

		{/* Numbered steps rather than plain cards: the four are one sequence, and
		    the ordinal is what carries that. The connecting rule is decorative, so
		    it is hidden from assistive tech and drawn only where the row is wide
		    enough for it to mean anything. */}
		<ol class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			{
				services.map((service, i) => (
					<li class="reveal step relative" style={`--reveal-delay: ${i * 140}ms`}>
						<div class="mb-5 flex items-center gap-4">
							<span
								class="step-badge flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-deep text-sm text-white"
								style="font-family: var(--font-display); font-weight: 600;"
								aria-hidden="true"
							>
								{String(i + 1).padStart(2, '0')}
							</span>
							{i < services.length - 1 && (
								<span
									class="reveal-rule hidden h-px flex-1 bg-gold-dark/25 lg:block"
									aria-hidden="true"
								/>
							)}
						</div>
						<h3
							class="mb-3 text-xl text-ink"
							style="font-family: var(--font-display); font-weight: 600;"
						>
							{service.title}
						</h3>
						<p class="text-sm leading-relaxed text-ink/75">{service.blurb}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	/* The badge overshoots slightly before settling — a step landing into place
	   rather than fading in. Scoped to the badge so nothing else inherits the
	   springy curve. */
	.step-badge {
		transform: scale(0.4);
		opacity: 0;
		transition:
			transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.5s ease-out;
		transition-delay: calc(var(--reveal-delay, 0ms) + 120ms);
	}

	.step.is-visible .step-badge {
		transform: scale(1);
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.step-badge {
			transition: none !important;
			transform: none !important;
			opacity: 1 !important;
		}
	}
</style>
