---
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/site';
---

<section id="services" class="bg-white/50 py-24">
	<div class="mx-auto max-w-page px-6">
		<SectionHeading eyebrow="Our Services" title="From First Study to Final Handover" class="mb-14" />

		{/* Numbered steps rather than plain cards: the four are one sequence, and
		    the ordinal is what carries that. The connecting rule is decorative, so
		    it is hidden from assistive tech and drawn only where the row is wide
		    enough for it to mean anything. */}
		<ol class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			{
				services.map((service, i) => (
					<li class="reveal relative" style={`--reveal-delay: ${i * 120}ms`}>
						{/* Decorative: the title beside it already names the step, so an
						    alt here would only repeat it to a screen reader. Sits above
						    the ordinal so every badge in the row still shares one
						    baseline and the connecting rule stays straight. */}
						{service.image && (
							<div class="mb-6 overflow-hidden rounded-3xl">
								<img
									src={service.image}
									alt=""
									loading="lazy"
									decoding="async"
									class="aspect-[4/3] w-full object-cover"
								/>
							</div>
						)}
						<div class="mb-5 flex items-center gap-4">
							<span
								class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gold-deep text-sm text-white"
								style="font-family: var(--font-display); font-weight: 600;"
								aria-hidden="true"
							>
								{String(i + 1).padStart(2, '0')}
							</span>
							{i < services.length - 1 && (
								<span class="hidden h-px flex-1 bg-gold-dark/25 lg:block" aria-hidden="true" />
							)}
						</div>
						<h3
							class="mb-3 text-2xl text-ink lg:text-[1.3rem]"
							style="font-family: var(--font-display); font-weight: 700;"
						>
							{service.title}
						</h3>
						<p class="text-sm leading-relaxed text-ink/75">{service.blurb}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
