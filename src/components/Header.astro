---
import { nav } from '../data/site';

interface Props {
	// `over` lifts the header onto the hero media (white-on-video). Pages
	// without a media hero render it on sand with the charcoal treatment.
	over?: boolean;
}

const { over = false } = Astro.props;
---

<header class={over ? 'absolute inset-x-0 top-0 z-20' : ''}>
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
		<a href="/" class="flex items-center gap-3" aria-label="Auristate — home">
			{/* The stacked lockup puts its wordmark at ~7% of its height, which is
			    illegible at header scale, so the mark is cropped out on its own and
			    set beside live text. See .logo-crop in global.css. */}
			<span class:list={['logo-crop logo-crop--mark h-14 md:h-16', over && 'logo-over']}>
				<img src="/transperate-logo.png" alt="" width="1005" height="1180" />
			</span>
			<span class="flex flex-col leading-none">
				<span
					class:list={[
						'text-lg tracking-[0.18em] uppercase md:text-xl',
						over ? 'text-white' : 'text-charcoal'
					]}
					style="font-family: var(--font-display); font-weight: 600;"
				>
					Auristate
				</span>
				<span
					class:list={[
						'mt-1 text-[0.6rem] tracking-[0.22em] uppercase',
						over ? 'text-white/70' : 'text-ink/75'
					]}
				>
					Tourism Investments
				</span>
			</span>
		</a>
		<nav class="hidden items-center gap-8 md:flex">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class:list={[
							'text-sm tracking-wide transition',
							over ? 'text-white/85 hover:text-gold-light' : 'text-ink/80 hover:text-gold-deep'
						]}
					>
						{item.label}
					</a>
				))
			}
		</nav>
		<div
			class:list={[
				'flex items-center gap-1 rounded-full px-3 py-1.5 text-xs tracking-widest',
				over ? 'bg-white/15 backdrop-blur-sm' : 'bg-white/60'
			]}
		>
			<span class:list={['font-semibold', over ? 'text-white' : 'text-ink']}>EN</span>
			<span class={over ? 'text-white/40' : 'text-ink/30'}>/</span>
			<a
				href="#"
				class:list={over ? 'text-white/70 hover:text-gold-light' : 'text-ink/75 hover:text-gold-deep'}
			>
				AR
			</a>
		</div>
	</div>
</header>
