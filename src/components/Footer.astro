---
import { nav, contact, social, footerTagline } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

{/* The page ends on the same dark ground the projects section uses mid-scroll.
    The palette inverts here exactly as it does there: gold-light is the
    accessible gold on dark (8.77:1) where gold-deep is not (3.04:1), and `ink`
    is unusable at 1.23:1 — every text color below is white at some opacity. */}
<footer class="bg-nearblack px-6 py-12">
	<div class="mx-auto grid max-w-page gap-8 md:grid-cols-4">
		<div>
			{/* The footer has the vertical room the header lacks, so it can use the
			    full lockup and keep the wordmark legible. The logo is transparent
			    with no pure-dark pixels, so it reads on this ground unmodified —
			    the same property that lets it sit over the hero video. */}
			<span class="logo-crop logo-crop--lockup h-24">
				<img src="/transperate-logo.png" alt="Auristate — Tourism Investments" width="1240" height="1436" />
			</span>
			<p class="mt-4 text-sm text-white/75">{footerTagline}</p>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-gold-light uppercase">Navigate</p>
			<ul class="space-y-2 text-sm text-white/75">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class="transition hover:text-gold-light">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-gold-light uppercase">Contact</p>
			<ul class="space-y-2 text-sm text-white/75">
				<li>
					<a href={`mailto:${contact.email}`} class="transition hover:text-gold-light">
						{contact.email}
					</a>
				</li>
				<li>
					{/* tel: needs the E.164 form; the display string keeps its spacing. */}
					<a
						href={`tel:${contact.phone.replace(/\s/g, '')}`}
						class="transition hover:text-gold-light"
					>
						{contact.phone}
					</a>
				</li>
				<li>{contact.address}</li>
			</ul>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-gold-light uppercase">Follow</p>
			{/* Icon-only, so each link carries its name in aria-label — the glyph is
			    aria-hidden inside SocialIcon. The 40px button is the touch target;
			    the glyph inside is 18px. */}
			<ul class="flex flex-wrap items-center gap-2">
				{
					social.map((s) => (
						<li>
							<a
								href={s.href}
								aria-label={s.label}
								class="flex h-10 w-10 items-center justify-center rounded-full text-white/75 ring-1 ring-white/20 transition hover:bg-white/10 hover:text-gold-light hover:ring-white/35"
							>
								<SocialIcon name={s.icon} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
	<div class="mx-auto mt-8 max-w-page border-t border-white/15 pt-5 text-xs text-white/70">
		© 2026 Auristate. All rights reserved.
	</div>
</footer>
