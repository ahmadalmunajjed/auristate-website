---
import { nav, contact, social, footerTagline } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

{/* Text here sits on sand-dark/60 (#d9c7a5) — the darkest light surface on the
    page. Measured: gold-deep only reaches 3.45:1 on it, so link hover shifts to
    ink + underline rather than gold. Gold stays for non-text accents. */}
<footer class="bg-sand-dark/60 px-6 py-12">
	<div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-4">
		<div>
			{/* The footer has the vertical room the header lacks, so it can use the
			    full lockup and keep the wordmark legible. The transparent PNG needs
			    no mix-blend-multiply to sit on sand. */}
			<span class="logo-crop logo-crop--lockup h-24">
				<img src="/transperate-logo.png" alt="Auristate — Tourism Investments" width="1240" height="1436" />
			</span>
			<p class="mt-4 text-sm text-ink/75">{footerTagline}</p>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-ink uppercase">Navigate</p>
			<ul class="space-y-2 text-sm text-ink/80">
				{
					nav.map((item) => (
						<li>
							<a href={item.href} class="transition hover:text-ink hover:underline">
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-ink uppercase">Contact</p>
			<ul class="space-y-2 text-sm text-ink/80">
				<li>
					<a href={`mailto:${contact.email}`} class="transition hover:text-ink hover:underline">
						{contact.email}
					</a>
				</li>
				<li>
					{/* tel: needs the E.164 form; the display string keeps its spacing. */}
					<a
						href={`tel:${contact.phone.replace(/\s/g, '')}`}
						class="transition hover:text-ink hover:underline"
					>
						{contact.phone}
					</a>
				</li>
				<li>{contact.address}</li>
			</ul>
		</div>
		<div>
			<p class="mb-4 text-xs tracking-widest text-ink uppercase">Follow</p>
			{/* Icon-only, so each link carries its name in aria-label — the glyph is
			    aria-hidden inside SocialIcon. Gold comes back here where it cannot in
			    the text links above: icons are non-text content, judged at 3:1 rather
			    than 4.5:1, and gold-deep measures 3.45:1 on this ground. The 40px
			    button is the touch target; the glyph inside is 18px. */}
			<ul class="flex flex-wrap items-center gap-2">
				{
					social.map((s) => (
						<li>
							<a
								href={s.href}
								aria-label={s.label}
								class="flex h-10 w-10 items-center justify-center rounded-full text-ink/80 ring-1 ring-ink/15 transition hover:bg-white/40 hover:text-gold-deep hover:ring-ink/25"
							>
								<SocialIcon name={s.icon} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
	{/* /75, not /70: at 12px this needs 4.5:1 and /70 measures 4.13 on #d9c7a5. */}
	<div class="mx-auto mt-8 max-w-6xl border-t border-ink/15 pt-5 text-xs text-ink/75">
		© 2026 Auristate. All rights reserved.
	</div>
</footer>
