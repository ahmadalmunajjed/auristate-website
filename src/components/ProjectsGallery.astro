---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/site';

// Renders nothing when empty, so index.astro can leave this mounted permanently.
const count = projects.length;

const layout = count === 1 ? 'feature' : count < 4 ? 'row' : 'mosaic';

const gridCols = layout === 'row' && count === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3';
---

{
	count > 0 && (
		<section id="projects" class="bg-nearblack py-24">
			{/* Heading is inlined, not SectionHeading: that component's text-ink
			    title is invisible on this dark ground and its gold-deep eyebrow
			    measures 3.04:1 here. */}
			<div class="mx-auto max-w-6xl px-6">
				<div class="reveal mb-12 flex items-end justify-between gap-6">
					<div>
						<p class="mb-4 text-xs tracking-[0.3em] text-gold-light uppercase">Our Projects</p>
						<h2
							class="reveal-text text-3xl text-white"
							style="font-family: var(--font-display); font-weight: 600;"
						>
							Selected Developments
						</h2>
					</div>
					<a
						href="/projects"
						class="hidden shrink-0 pb-1 text-sm text-white/80 transition hover:text-gold-light md:block"
					>
						View All Projects →
					</a>
				</div>
			</div>

			{/* Full-bleed with thin seams, per the reference design. */}
			<div class="px-3">
				{
					layout === 'feature' ? (
						<ProjectCard project={projects[0]} index={0} variant="feature" />
					) : (
						// items-start: the mosaic's wide tile is taller than its
						// row-mates, and stretch would pad the others with dead space.
						<div class:list={['grid items-start gap-3', gridCols]}>
							{projects.map((project, i) => (
								<ProjectCard
									project={project}
									index={i}
									variant={layout === 'mosaic' && i === 0 ? 'wide' : 'default'}
								/>
							))}
						</div>
					)
				}
			</div>

			<div class="mx-auto max-w-6xl px-6">
				<a
					href="/projects"
					class="reveal mt-10 block text-sm text-white/80 transition hover:text-gold-light md:hidden"
				>
					View All Projects →
				</a>
			</div>
		</section>
	)
}
