---
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/site';

// Renders nothing when empty, so index.astro can leave this mounted permanently.
const count = projects.length;

// A coverflow needs a middle and two shoulders, so it starts at three. Below
// that the old layouts still serve: one card cannot have neighbours, and two
// centred with one dimmed just reads as a broken pair.
const layout = count === 1 ? 'feature' : count === 2 ? 'row' : 'coverflow';

// Arrows only earn their place once the track has somewhere to go on desktop.
// At exactly three the row fits its container there and never scrolls.
const scrolls = count > 3;

// The slide the carousel opens on: the second, not the first. Index 1 always
// exists here — a coverflow needs three cards to start.
const focusIndex = 1;

// The **no-JS** active slide, which is a different question: with no script
// there is nothing to scroll the track, so the emphasised card has to be the one
// the resting scroll position already centres. Three cards sit centred, so that
// is the middle; four or more open scrolled hard left, where the track's
// scroll-padding centres the first. Marking `focusIndex` here instead would
// leave a full-size card sitting off-centre for anyone without JS.
const initialActive = scrolls ? 0 : Math.floor(count / 2);
---

{
	count > 0 && (
		<section id="projects" class="bg-nearblack py-24">
			{/* Heading is inlined, not SectionHeading: that component's text-ink
			    title is invisible on this dark ground and its gold-deep eyebrow
			    measures 3.04:1 here. */}
			<div class="mx-auto max-w-page px-6">
				<div class="reveal mb-12 flex items-end justify-between gap-6">
					<div>
						<p class="mb-4 text-sm tracking-[0.3em] text-gold-light uppercase">Our Projects</p>
						{/* Sized by hand to match SectionHeading — keep the two in step. */}
						<h2
							class="text-[2.25rem] text-white lg:text-[3.25rem] xl:text-[3.5rem]"
							style="font-family: var(--font-display); font-weight: 600;"
						>
							Selected Developments
						</h2>
					</div>
					<a
						href="/projects"
						class="hidden shrink-0 pb-1 text-sm text-white/80 transition hover:text-gold-light md:block"
					>
						View All Projects →
					</a>
				</div>
			</div>

			{layout === 'coverflow' ? (
				// One reveal for the whole track. Per-card reveals cannot work here
				// — see the `reveal` prop on ProjectCard.
				<div
					class:list={['cf reveal mx-auto w-full max-w-page', !scrolls && 'cf--fits']}
					data-cf
					data-cf-focus={String(focusIndex)}
				>
					<div class="cf-track" id="projects-track" data-cf-track>
						{projects.map((project, i) => (
							<div class:list={['cf-slide', i === initialActive && 'is-active']} data-cf-slide>
								<ProjectCard project={project} index={i} reveal={false} />
							</div>
						))}
					</div>

					{scrolls && (
						<Fragment>
							<button
								type="button"
								class="cf-nav cf-nav--prev"
								aria-label="Previous project"
								aria-controls="projects-track"
								data-cf-prev
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									class="h-5 w-5"
								>
									<path d="m15 5-7 7 7 7" />
								</svg>
							</button>
							<button
								type="button"
								class="cf-nav cf-nav--next"
								aria-label="Next project"
								aria-controls="projects-track"
								data-cf-next
							>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									class="h-5 w-5"
								>
									<path d="m9 5 7 7-7 7" />
								</svg>
							</button>
						</Fragment>
					)}
				</div>
			) : (
				/* Full-bleed with thin seams, per the reference design. */
				<div class="px-3">
					{layout === 'feature' ? (
						<ProjectCard project={projects[0]} index={0} variant="feature" />
					) : (
						<div class="grid items-start gap-3 md:grid-cols-2">
							{projects.map((project, i) => (
								<ProjectCard project={project} index={i} />
							))}
						</div>
					)}
				</div>
			)}

			<div class="mx-auto max-w-page px-6">
				<a
					href="/projects"
					class="reveal mt-10 block text-sm text-white/80 transition hover:text-gold-light md:hidden"
				>
					View All Projects →
				</a>
			</div>
		</section>
	)
}

<style>
	.cf {
		position: relative;
		/* A length, never a percentage: the track's own padding is derived from
		   this, so a percentage here would resolve against a box that depends on
		   it. Capped in rem so the cards stop growing on wide monitors — three at
		   24rem plus seams lands on the 72rem the heading above uses. */
		--cf-w: min(78vw, 20rem);
	}

	.cf-track {
		display: flex;
		gap: 0.75rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		/* Half a viewport minus half a card: lets the first and last slides reach
		   the centre instead of stopping at the track's edge. */
		padding-inline: calc(50% - var(--cf-w) / 2);
		/* The arrows and the peeking neighbours are the affordance. */
		scrollbar-width: none;
	}

	.cf-track::-webkit-scrollbar {
		display: none;
	}

	.cf-slide {
		flex: 0 0 var(--cf-w);
		scroll-snap-align: center;
		/* `scale`, not `transform`: ProjectCard's .reveal owns transform, and
		   .reveal.is-visible resets it to none. The layout box stays full size,
		   so shrinking a neighbour cannot shove the centred card off-centre. */
		scale: 0.84;
		opacity: 0.5;
		transition:
			scale 0.6s cubic-bezier(0.2, 0.6, 0.2, 1),
			opacity 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
	}

	.cf-slide.is-active {
		scale: 1;
		opacity: 1;
	}

	.cf-nav {
		position: absolute;
		top: 50%;
		/* Standalone `translate` so it cannot collide with a transform. */
		translate: 0 -50%;
		z-index: 2;
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		color: #fff;
		border: 1px solid rgb(255 255 255 / 0.25);
		/* Square, like the type pill and the section's seams — this section
		   deliberately drops the site's rounded language. */
		background: rgb(26 26 26 / 0.7);
		backdrop-filter: blur(6px);
		transition:
			background-color 0.3s ease,
			color 0.3s ease,
			opacity 0.3s ease;
	}

	/* Arrows do nothing without the script, so the script reveals them. */
	.cf-ready .cf-nav {
		display: flex;
	}

	.cf-nav--prev {
		left: 0.75rem;
	}

	.cf-nav--next {
		right: 0.75rem;
	}

	.cf-nav:hover {
		background: #fff;
		color: var(--color-nearblack);
	}

	.cf-nav:focus-visible {
		outline: 2px solid var(--color-gold-light);
		outline-offset: 3px;
	}

	/* aria-disabled, not the disabled attribute: a real disable drops focus to
	   the body the moment a keyboard user reaches the last slide. */
	.cf-nav[aria-disabled='true'] {
		opacity: 0.35;
		cursor: default;
	}

	.cf-nav[aria-disabled='true']:hover {
		background: rgb(26 26 26 / 0.7);
		color: #fff;
	}

	@media (min-width: 1024px) {
		.cf {
			--cf-w: min(30vw, 24rem);
		}

		/* Three cards fit the viewport here, so drop the centring padding and let
		   them sit as a row with the middle one carrying the focus. */
		.cf--fits .cf-track {
			padding-inline: 0;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.cf-track {
			scroll-behavior: smooth;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cf-slide {
			transition: none;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll<HTMLElement>('[data-cf]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-cf-track]');
		if (!track) return;

		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-cf-slide]'));
		if (!slides.length) return;

		const prev = root.querySelector<HTMLElement>('[data-cf-prev]');
		const next = root.querySelector<HTMLElement>('[data-cf-next]');

		// Only now do the arrows exist as far as CSS is concerned.
		root.classList.add('cf-ready');

		/** Nearest slide centre to the track's centre wins. Rects rather than
		 *  offsetLeft: a scaled slide reports a smaller rect but the same centre,
		 *  and this needs no assumption about which element is the offsetParent. */
		const sync = () => {
			const bounds = track.getBoundingClientRect();
			const middle = bounds.left + bounds.width / 2;

			let active = 0;
			let shortest = Infinity;

			slides.forEach((slide, i) => {
				const rect = slide.getBoundingClientRect();
				const distance = Math.abs(rect.left + rect.width / 2 - middle);
				if (distance < shortest) {
					shortest = distance;
					active = i;
				}
			});

			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));

			if (!prev || !next) return;
			const furthest = track.scrollWidth - track.clientWidth;
			// 1px of slack: smooth scrolling and fractional layout widths mean
			// scrollLeft rarely lands exactly on 0 or the maximum.
			prev.setAttribute('aria-disabled', String(track.scrollLeft <= 1));
			next.setAttribute('aria-disabled', String(track.scrollLeft >= furthest - 1));
		};

		let queued = false;
		const queueSync = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				sync();
			});
		};

		/** One card plus its seam, measured rather than assumed — the width is a
		 *  min() of a viewport unit and a cap, so it changes with the breakpoint.
		 *  offsetLeft, not getBoundingClientRect: rects are scaled, so an inactive
		 *  neighbour's left edge reads ~8% of a card too far in and every click
		 *  would overshoot. Layout positions ignore `scale`. */
		const step = () =>
			slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : slides[0].offsetWidth;

		const scrollBy = (direction: number) => {
			track.scrollBy({
				left: direction * step(),
				behavior: reduceMotion.matches ? 'auto' : 'smooth'
			});
		};

		prev?.addEventListener('click', () => {
			if (prev.getAttribute('aria-disabled') === 'true') return;
			scrollBy(-1);
		});

		next?.addEventListener('click', () => {
			if (next.getAttribute('aria-disabled') === 'true') return;
			scrollBy(1);
		});

		/** Rect centres are scale-proof: the slides shrink about their own centre,
		 *  so only their size changes, never their middle. */
		const centre = (index: number, behavior: ScrollBehavior) => {
			const slide = slides[index];
			if (!slide) return;

			const bounds = track.getBoundingClientRect();
			const rect = slide.getBoundingClientRect();
			const delta = rect.left + rect.width / 2 - (bounds.left + bounds.width / 2);
			if (Math.abs(delta) < 1) return;

			track.scrollBy({ left: delta, behavior });
		};

		/** Tabbing to a card the browser judges "partly visible" scrolls nothing,
		 *  so keyboard focus lands on a sliver of a card clipped by the track. */
		track.addEventListener('focusin', (event) => {
			const slide = (event.target as HTMLElement).closest<HTMLElement>('[data-cf-slide]');
			if (!slide) return;

			centre(slides.indexOf(slide), reduceMotion.matches ? 'auto' : 'smooth');
		});

		track.addEventListener('scroll', queueSync, { passive: true });
		// The breakpoint swaps --cf-w and, at three cards, the whole padding
		// model, so every measurement above goes stale on resize.
		new ResizeObserver(queueSync).observe(track);

		// Open on the requested slide rather than wherever scrollLeft 0 lands.
		// `instant`, not `smooth`: the section is usually below the fold, and a
		// carousel caught mid-animation on arrival reads as the page moving by
		// itself. Where the track cannot scroll — three cards on desktop — the
		// delta is zero and this is a no-op, which is correct: the middle card is
		// already the second one.
		centre(Number(root.dataset.cfFocus) || 0, 'instant');

		// After the scroll, never before: sync() derives the active slide from the
		// resting scroll position, so calling it first would mark the wrong card.
		sync();
	});
</script>
