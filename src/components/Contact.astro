---
import SectionHeading from './SectionHeading.astro';
import SocialIcon from './SocialIcon.astro';
import { contact, contactSection } from '../data/site';

const telHref = `tel:${contact.phone.replace(/\s/g, '')}`;
const waHref = `https://wa.me/${contact.phone.replace(/\D/g, '')}`;
const mailHref = `mailto:${contact.email}`;

// Full-opacity gold-dark: the border is the input's only boundary and needs 3:1
// (3.19:1 here). gold-deep for the focus ring — gold-dark fails the same line.
const fieldClass =
	'mt-2 w-full rounded-2xl border border-gold-dark bg-white px-4 py-3 text-ink transition focus:border-gold-deep focus:ring-2 focus:ring-gold-deep/70 focus:outline-none';
const labelClass = 'text-xs tracking-[0.2em] text-gold-deep uppercase';
---

{/* Keep id="contact" — the header nav, the footer's copy of it, and the hero's
    "Get in Touch" CTA all anchor here. */}
<section id="contact" class="bg-white/50 py-20">
	<div class="mx-auto max-w-page px-6">
		<div class="grid gap-x-16 gap-y-12 md:grid-cols-[minmax(0,4fr)_minmax(0,6fr)]">
			<div class="reveal">
				<SectionHeading eyebrow={contactSection.eyebrow} title={contactSection.title} />
				<span class="ct-rule mt-6 block" aria-hidden="true"></span>

				<p class="mt-8 max-w-sm leading-relaxed text-ink/75">{contactSection.lead}</p>

				{/* The form needs a mail client and JS; these three links need neither. */}
				<dl class="mt-10 space-y-6 text-sm">
					<div>
						<dt class={labelClass}>Email</dt>
						<dd class="mt-1.5">
							<a href={mailHref} class="text-ink/85 transition hover:text-gold-deep">
								{contact.email}
							</a>
						</dd>
					</div>
					<div>
						<dt class={labelClass}>Phone</dt>
						<dd class="mt-1.5">
							<a href={telHref} class="text-ink/85 transition hover:text-gold-deep">
								{contact.phone}
							</a>
						</dd>
					</div>
					<div>
						<dt class={labelClass}>Office</dt>
						<dd class="mt-1.5 text-ink/85">{contact.address}</dd>
					</div>
				</dl>

				<a
					href={waHref}
					class="mt-9 inline-flex items-center gap-2.5 rounded-full border border-gold-dark px-6 py-3 text-sm tracking-wide text-ink transition hover:bg-gold-dark/12 hover:text-gold-deep"
				>
					<SocialIcon name="whatsapp" class="h-[1.05rem] w-[1.05rem]" />
					Message on WhatsApp
				</a>
			</div>

			{/* No `action`: the site is static, so the script below composes a mailto:. */}
			<form
				data-contact-form
				data-to={contact.email}
				data-subject-prefix={contactSection.subjectPrefix}
				class="reveal rounded-3xl border border-gold-dark/20 bg-white/70 p-6 md:p-8"
				style="--reveal-delay: 120ms"
			>
				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label class={labelClass} for="ct-name">Name</label>
						<input id="ct-name" name="name" type="text" required autocomplete="name" class={fieldClass} />
					</div>
					<div>
						<label class={labelClass} for="ct-email">Email</label>
						<input
							id="ct-email"
							name="email"
							type="email"
							required
							autocomplete="email"
							class={fieldClass}
						/>
					</div>
				</div>

				<div class="mt-5">
					<label class={labelClass} for="ct-phone">Phone (optional)</label>
					<input id="ct-phone" name="phone" type="tel" autocomplete="tel" class={fieldClass} />
				</div>

				<div class="mt-5">
					<label class={labelClass} for="ct-message">Your enquiry</label>
					{/* Keeps the assembled mailto: URL inside the ~2000 chars the
					    shortest-limit mail clients accept. */}
					<textarea
						id="ct-message"
						name="message"
						required
						rows="6"
						maxlength="1200"
						class={`${fieldClass} resize-y`}></textarea>
				</div>

				<div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
					{/* gold-deep, not the hero's gold-dark: white measures 5.73:1 here
					    against 3.59:1 there. Hover brightens for the same reason. */}
					<button
						type="submit"
						class="rounded-full bg-gold-deep px-8 py-3.5 text-sm font-medium tracking-wide text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep"
					>
						Send Enquiry
					</button>
					<p class="max-w-xs text-xs leading-relaxed text-ink/75">
						Opens your email app with the message ready to send. No email app? Write to
						<a href={mailHref} class="underline underline-offset-2 transition hover:text-gold-deep"
							>{contact.email}</a
						>.
					</p>
				</div>

				<p data-contact-status role="status" class="mt-4 text-sm text-ink/85"></p>
			</form>
		</div>
	</div>
</section>

<style>
	.ct-rule {
		height: 1px;
		width: 4rem;
		background: linear-gradient(to right, var(--color-gold-dark), transparent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1) 0.2s;
	}

	.reveal.is-visible .ct-rule {
		transform: scaleX(1);
	}

	/* The global reduce block only covers .reveal / .animate-*, and this waits on
	   .is-visible, which reveal.js adds regardless of motion preference. */
	@media (prefers-reduced-motion: reduce) {
		.ct-rule {
			transition: none !important;
			transform: none !important;
		}
	}
</style>

<script>
	// Composed here rather than with action="mailto:", whose behaviour varies by
	// browser and which Chrome fronts with a warning dialog.
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

	if (form) {
		const status = form.querySelector<HTMLElement>('[data-contact-status]');
		const to = form.dataset.to ?? '';
		const subjectPrefix = form.dataset.subjectPrefix ?? 'Website enquiry';

		// encodeURIComponent emits a bare %0A for "\n", which Outlook collapses
		// into one run of text.
		const encode = (value: string) => encodeURIComponent(value.replace(/\r?\n/g, '\r\n'));

		form.addEventListener('submit', (event) => {
			event.preventDefault();

			const data = new FormData(form);
			const field = (key: string) => String(data.get(key) ?? '').trim();

			const name = field('name');
			const phone = field('phone');

			const details = [`Name: ${name}`, `Email: ${field('email')}`];
			if (phone) details.push(`Phone: ${phone}`);

			const subject = name ? `${subjectPrefix} from ${name}` : subjectPrefix;
			const body = `${details.join('\n')}\n\n${field('message')}\n`;

			window.location.href = `mailto:${to}?subject=${encode(subject)}&body=${encode(body)}`;

			// Set rather than unhidden — role="status" announces a text change.
			if (status) status.textContent = `Opening your email app to send to ${to}…`;
		});
	}
</script>
