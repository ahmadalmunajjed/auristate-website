---
import {PortableText} from 'astro-portabletext';
import Layout from '../../layouts/Layout.astro';
import {getAllPosts, getPost, urlFor} from '../../lib/sanity';

// Queries used here come from a utility module, not module-scope consts in this
// file: Astro hoists getStaticPaths() into its own module context, where local
// consts are not in scope.
export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({params: {slug: post.slug}}));
}

const {slug} = Astro.params;
const post = await getPost(slug!);

// getStaticPaths only emits slugs that exist, so this is a type guard rather
// than a real branch — but it keeps the build honest if that ever changes.
if (!post) {
	return Astro.redirect('/blog');
}

const dateLabel = post.date
	? new Date(post.date).toLocaleDateString('en-GB', {
			day: 'numeric',
			month: 'long',
			year: 'numeric'
		})
	: null;

const hero = post.cover
	? urlFor(post.cover).width(1600).height(900).fit('crop').auto('format').quality(80).url()
	: null;

// Absolute URL — Layout runs it through new URL(image, Astro.site), and social
// platforms reject relative paths.
const shareImage = post.cover
	? urlFor(post.cover).width(1200).height(630).fit('crop').auto('format').quality(80).url()
	: undefined;
---

<Layout
	title={`${post.title} — Auristate`}
	description={post.seoDescription ?? post.excerpt}
	image={shareImage}
>
	<article class="py-24">
		<div class="mx-auto max-w-3xl px-6">
			<a
				href="/blog"
				class="reveal mb-10 inline-block text-sm text-ink/75 transition hover:text-gold-deep"
			>
				← All News
			</a>

			<header class="reveal">
				{
					dateLabel && (
						<p class="mb-4 text-xs tracking-[0.2em] text-gold-deep uppercase">{dateLabel}</p>
					)
				}
				<h1
					class="text-3xl leading-tight text-ink md:text-4xl"
					style="font-family: var(--font-display); font-weight: 600;"
				>
					{post.title}
				</h1>
				<p class="mt-6 text-lg leading-relaxed text-ink/75">{post.excerpt}</p>
			</header>
		</div>

		{
			hero && (
				<div class="reveal mx-auto mt-14 max-w-page px-6">
					<div class="aspect-[16/9] overflow-hidden rounded-3xl bg-sand">
						<img
							src={hero}
							alt={post.cover?.alt ?? ''}
							loading="eager"
							decoding="async"
							class="h-full w-full object-cover"
						/>
					</div>
				</div>
			)
		}

		{
			post.body && (
				<div class="reveal prose-auristate mx-auto mt-14 max-w-3xl px-6">
					<PortableText value={post.body as any} />
				</div>
			)
		}
	</article>
</Layout>

<style is:global>
	/* No typography plugin in this project, so the rich-text body gets its
	   rhythm here. Scoped to .prose-auristate so it cannot leak into the
	   hand-built sections. */
	.prose-auristate p,
	.prose-auristate ul,
	.prose-auristate ol {
		margin-block: 1.25rem;
		line-height: 1.75;
		color: color-mix(in srgb, var(--color-ink) 80%, transparent);
	}

	.prose-auristate h2,
	.prose-auristate h3 {
		font-family: var(--font-display);
		font-weight: 600;
		color: var(--color-ink);
		margin-block: 2.5rem 1rem;
	}

	.prose-auristate h2 {
		font-size: 1.75rem;
		line-height: 1.3;
	}

	.prose-auristate h3 {
		font-size: 1.35rem;
		line-height: 1.4;
	}

	.prose-auristate ul,
	.prose-auristate ol {
		padding-inline-start: 1.5rem;
	}

	.prose-auristate ul {
		list-style: disc;
	}

	.prose-auristate ol {
		list-style: decimal;
	}

	.prose-auristate li {
		margin-block: 0.5rem;
	}

	.prose-auristate a {
		color: var(--color-gold-deep);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.prose-auristate blockquote {
		border-inline-start: 2px solid var(--color-gold-dark);
		padding-inline-start: 1.25rem;
		font-style: italic;
		margin-block: 1.75rem;
	}

	.prose-auristate img {
		border-radius: 1.5rem;
		margin-block: 2rem;
		width: 100%;
		height: auto;
	}
</style>
