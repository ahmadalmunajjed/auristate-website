---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';
import {getAllPosts} from '../../lib/sanity';

const posts = await getAllPosts();
---

<Layout
	title="News — Auristate"
	description="News and updates from Auristate Tourism Investment: project milestones, developments, and announcements."
>
	<section class="py-24">
		<div class="mx-auto max-w-page px-6">
			<div class="reveal mb-14">
				<SectionHeading eyebrow="News" title="Latest from Auristate" />
			</div>

			{
				posts.length > 0 ? (
					<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-10">
						{posts.map((post, i) => (
							<PostCard post={post} index={i} />
						))}
					</div>
				) : (
					/* An empty state rather than a bare heading over nothing. The
					   section is reachable from the nav, so it has to say something
					   when there is no content yet. */
					<p class="reveal max-w-xl leading-relaxed text-ink/75">
						There are no articles yet. Updates on our developments will be published here.
					</p>
				)
			}
		</div>
	</section>
</Layout>
