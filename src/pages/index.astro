---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Stats from '../components/Stats.astro';
import ProjectsGallery from '../components/ProjectsGallery.astro';
import Services from '../components/Services.astro';
import News from '../components/News.astro';
import VisionMission from '../components/VisionMission.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Auristate — Tourism & Real Estate Investment in Syria">
	<div class="bg-sand text-charcoal">
		<!-- Header sits over the hero media, so it is positioned relative to this
		     wrapper rather than stacked above the section. -->
		<div class="relative">
			<Header over />
			<Hero />
		</div>
		<About />
		<Stats />
		<ProjectsGallery />
		<Services />
		<News />
		<VisionMission />
		<CtaBand />
		<Footer />
	</div>
</Layout>

<script>
	import '../scripts/reveal.js';
</script>
