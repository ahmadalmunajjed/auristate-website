---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
// Renders nothing while no projects are published in Sanity.
import ProjectsGallery from '../components/ProjectsGallery.astro';
import Services from '../components/Services.astro';
// Renders nothing while no posts are published in Sanity.
import News from '../components/News.astro';
import VisionMission from '../components/VisionMission.astro';
import Contact from '../components/Contact.astro';
import {getAllProjects, getLatestPost} from '../lib/sanity';

// Fetched once at build time. A publish in the Studio fires a webhook that
// rebuilds the site, so this is as live as the deploy.
const projects = await getAllProjects();
const latestPost = await getLatestPost();
---

{/* Plain "&" — Astro escapes prop values, so an &amp; entity here would ship
    as the literal text "&amp;" in the title and every share preview. */}
{/* headerOver: this page opens on the full-bleed hero video, so the header
    rides over it. Pages without a media hero omit it. */}
<Layout title="Auristate — Tourism & Real Estate Investment in Syria" headerOver>
	{/* Scopes the sticky stack: Hero and About pin to the top of the viewport
	    while Our Projects rises over them, and all three release once this
	    wrapper's bottom passes — behind the opaque projects section, so the
	    handoff is never seen. Projects has to be inside it: sticky travel is
	    bounded by the containing block, so with Hero and About alone About's
	    bottom would be the wrapper's and it would have nowhere to hold. */}
	<div>
		<Hero />
		<About />
		<ProjectsGallery projects={projects} />
	</div>
	<Services />
	<News post={latestPost} />
	<VisionMission />
	<Contact />
</Layout>
