---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
// Renders nothing while `projects` in site.ts is empty.
import ProjectsGallery from '../components/ProjectsGallery.astro';
import Services from '../components/Services.astro';
// Renders nothing while `posts` in site.ts is empty.
import News from '../components/News.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';

// Awaiting client copy — the text still in this component was invented.
// import VisionMission from '../components/VisionMission.astro';
---

<Layout title="Auristate — Tourism Investment">
	<div class="bg-sand text-ink">
		<!-- Header sits over the hero media, so it is positioned relative to this
		     wrapper rather than stacked above the section. -->
		<div class="relative">
			<Header over />
			<Hero />
		</div>
		<About />
		<ProjectsGallery />
		<Services />
		<News />
		<!-- <VisionMission /> -->
		<CtaBand />
		<Footer />
	</div>
</Layout>

<script>
	import '../scripts/reveal.js';
</script>
