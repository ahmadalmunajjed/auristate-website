# Sanity — copy this file to `.env` and fill in the values.
#
# These are read at BUILD time only: every page is statically generated, so the
# browser never talks to Sanity. Neither value is a secret (the project ID is
# visible in any Sanity-backed site), but they use Astro's PUBLIC_ prefix so
# nothing breaks if a client-side module ever imports src/lib/sanity.ts.
#
# On Cloudflare Pages these must also be set as *build* environment variables:
# Workers & Pages -> your project -> Settings -> Variables and Secrets.
PUBLIC_SANITY_PROJECT_ID=s055z044
PUBLIC_SANITY_DATASET=production

# Only needed to run scripts/seed-projects.mjs, which writes to Sanity.
# LOCAL ONLY — never add this to Cloudflare. The site build only ever reads.
# Create at sanity.io/manage -> API -> Tokens (Editor role). Revoke after seeding.
SANITY_WRITE_TOKEN=
