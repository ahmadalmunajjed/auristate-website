# Sanity — copy this file to `.env` for local development.
#
# BOTH OF THESE ARE OPTIONAL. src/lib/sanity.ts defaults to s055z044/production,
# so the site builds without them and logs a warning. Set them only to point a
# build at a different project or dataset (a staging dataset, say).
#
# Read at BUILD time only: every page is statically generated, so the browser
# never talks to Sanity. Neither value is a secret — both appear in every image
# URL the site serves — but they carry Astro's PUBLIC_ prefix so nothing breaks
# if a client-side module ever imports src/lib/sanity.ts.
PUBLIC_SANITY_PROJECT_ID=s055z044
PUBLIC_SANITY_DATASET=production

# Only needed to run scripts/seed-projects.mjs, which writes to Sanity.
# LOCAL ONLY — never add this to Cloudflare. The site build only ever reads.
# Create at sanity.io/manage -> API -> Tokens (Editor role). Revoke after seeding.
SANITY_WRITE_TOKEN=
